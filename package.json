{
  "name": "siela-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @siela/db generate",
    "db:migrate": "pnpm --filter @siela/bot migrate",
    "dev:bot": "pnpm --filter @siela/bot dev",
    "dev:mcp": "pnpm --filter @siela/mcp dev",
    "podman:config": "podman compose -p siela -f deploy/podman/compose.yaml config",
    "podman:smoke": "./scripts/podman-compose-smoke.sh"
  }
}
