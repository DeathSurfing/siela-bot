FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends libsndfile1 && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu "pocket-tts[audio]==4.0.1"

EXPOSE 8000
CMD ["pocket-tts", "serve", "--host", "0.0.0.0", "--port", "8000", "--language", "english"]
