FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends libsndfile1 libgomp1 && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    onnxruntime \
    numpy \
    sentencepiece \
    scipy \
    soundfile \
    fastapi \
    uvicorn \
    python-multipart \
    huggingface_hub \
    safetensors

RUN python - <<'PY'
from huggingface_hub import snapshot_download
import urllib.request

snapshot_download(
    repo_id="KevinAHM/pocket-tts-onnx",
    allow_patterns=["pocket_tts_onnx.py", "onnx/english_2026-04/*"],
    local_dir="/app",
)
urllib.request.urlretrieve(
    "https://huggingface.co/kyutai/tts-voices/resolve/main/alba-mackenna/casual.wav",
    "/app/fallback.wav",
)
PY

COPY deploy/tts/tts_server.py /app/tts_server.py

WORKDIR /app
EXPOSE 8000
CMD ["uvicorn", "tts_server:app", "--host", "0.0.0.0", "--port", "8000"]
