# Siela Bot — bot image
# Build from the repository root:
#   podman build -f deploy/podman/Containerfile.bot -t siela-bot .

FROM oven/bun:1 AS build
WORKDIR /app
COPY package.json bun.lock .npmrc bunfig.toml tsconfig.base.json ./
COPY apps/bot/package.json apps/bot/package.json
COPY apps/mcp/package.json apps/mcp/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN bun install --frozen-lockfile
COPY . .
RUN bun run --cwd apps/bot build
RUN mkdir -p /out && cp -Lr /app/apps/bot/dist /out/dist && cp -Lr /app/node_modules /out/node_modules && mkdir -p /out/assets /out/packages/db && cp -r /app/apps/bot/assets /out/assets && cp -r /app/packages/db/drizzle /out/packages/db/drizzle

FROM oven/bun:1 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg mpv python3 python3-pip ca-certificates fontconfig fonts-dejavu fonts-noto-cjk \
  && pip3 install --no-cache-dir --break-system-packages yt-dlp edge-tts==7.3.1 torch --index-url https://download.pytorch.org/whl/cu121 kittenml soundfile \
  && python3 -c "from kittenml import KittenTTS; KittenTTS('KittenML/kitten-tts-2')" \
  && rm -rf /var/lib/apt/lists/* /root/.cache
ENV NODE_ENV=production
ENV XDG_CACHE_HOME=/tmp
WORKDIR /app
COPY --from=build /out/ ./
USER bun
CMD ["bun", "dist/index.js"]
