# Siela Bot — bot image
# Build from the repository root:
#   podman build -f deploy/podman/Containerfile.bot -t siela-bot .

FROM oven/bun:1 AS build
WORKDIR /app
COPY package.json bun.lock .npmrc tsconfig.base.json ./
COPY apps/bot/package.json apps/bot/package.json
COPY apps/mcp/package.json apps/mcp/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN bun install --frozen-lockfile
COPY . .
RUN bun run --cwd apps/bot build
RUN mkdir -p /out && cp -Lr /app/apps/bot/dist /out/dist && cp -Lr /app/node_modules /out/node_modules && mkdir -p /out/assets /out/packages/db && cp -r /app/apps/bot/assets /out/assets && cp -r /app/packages/db/drizzle /out/packages/db/drizzle

FROM node:24-alpine AS runtime
RUN apk add --no-cache ffmpeg mpv python3 py3-pip ca-certificates fontconfig ttf-dejavu font-noto-cjk \
  && pip install --no-cache-dir --break-system-packages yt-dlp edge-tts==7.3.1
ENV NODE_ENV=production
ENV XDG_CACHE_HOME=/tmp
WORKDIR /app
COPY --from=build /out/ ./
USER node
CMD ["node", "dist/index.js"]
