# Siela Bot — bot image
# Build from the repository root:
#   podman build -f deploy/podman/Containerfile.bot -t siela-bot .

FROM node:24-alpine AS build
RUN npm install -g pnpm@12.14.0
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY apps/bot/package.json apps/bot/package.json
COPY apps/mcp/package.json apps/mcp/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter @siela/bot build
RUN pnpm --filter @siela/bot deploy --prod /out

FROM node:24-alpine AS runtime
RUN apk add --no-cache ffmpeg mpv python3 py3-pip ca-certificates fontconfig ttf-dejavu font-noto-cjk \
  && pip install --no-cache-dir --break-system-packages yt-dlp edge-tts==7.3.1
ENV NODE_ENV=production
ENV XDG_CACHE_HOME=/tmp
WORKDIR /app
COPY --from=build /out/ ./
COPY --from=build /app/apps/bot/assets ./assets
COPY --from=build /app/packages/db/drizzle ./packages/db/drizzle
USER node
CMD ["node", "dist/index.js"]
