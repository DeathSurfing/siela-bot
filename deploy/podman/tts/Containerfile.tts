FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir kittenml soundfile fastapi uvicorn
ENV HF_HOME=/root/.cache
WORKDIR /app
COPY server.py /app/server.py
RUN python3 -c "from kittenml import KittenTTS; KittenTTS('KittenML/kitten-tts-2')"
EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
