FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends espeak-ng libespeak-ng1 ca-certificates && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir phonemizer onnxruntime numpy soundfile huggingface_hub fastapi uvicorn
RUN pip install --no-cache-dir --no-deps https://github.com/KittenML/KittenTTS/releases/download/0.8/kittentts-0.8.0-py3-none-any.whl
RUN sed -i '/from misaki import/d' /usr/local/lib/python3.11/site-packages/kittentts/onnx_model.py
ENV HF_HOME=/root/.cache
RUN python -c "from kittentts import KittenTTS; KittenTTS('KittenML/kitten-tts-nano-0.8')"
WORKDIR /app
COPY server.py /app/server.py
EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
