# Siela Bot — minimal configuration
#
# Do NOT commit .env.
# Preferred: run scripts/podman-init.sh with DISCORD_TOKEN in the
# environment; it derives the client ID, generates the internal secrets,
# and writes .env (600).
#
# Only DISCORD_TOKEN is required from a human.

# --- required ---
DISCORD_TOKEN=replace-me

# --- optional: derived/auto-detected ---
# The init script derives DISCORD_CLIENT_ID from the token.
DISCORD_CLIENT_ID=
# Auto-detected at boot when the bot is in exactly one guild.
GUILD_ID=

# --- generated by scripts/podman-init.sh ---
POSTGRES_USER=siela
POSTGRES_DB=siela
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgres://siela:replace-me@postgres:5432/siela
LAVALINK_PASSWORD=replace-me
LAVALINK_URL=http://lavalink:2333
MCP_TOKEN=replace-me
MCP_URL=http://mcp:8080/mcp

# --- optional: Spotify search (SoundCloud works without these) ---
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- optional defaults ---
LIBRETRANSLATE_URL=http://libretranslate:5000
CONTROL_API_URL=http://bot-control:3001
DEFAULT_PREFIX=!
LOG_LEVEL=info
TZ=UTC
