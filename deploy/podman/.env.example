# Siela Bot — configuration
#
# Do NOT commit .env.
# Preferred: run scripts/podman-init.sh with DISCORD_TOKEN in the
# environment; it derives the client ID, generates the internal secrets,
# and writes .env (600).
#
# Only DISCORD_TOKEN is required from a human. Placeholders below are
# obviously fake but satisfy validation (DISCORD_TOKEN min 20 chars,
# MCP_TOKEN min 16 chars) so `podman-compose-smoke.sh config` passes.

# --- required ---
DISCORD_TOKEN=FAKE-DISCORD-TOKEN-REPLACE-ME-000000

# --- internal control bearer ---
# Authenticates the bot control API (:3001). Generated by scripts/podman-init.sh.
# Keep it secret; anyone with it can change guild configuration.
MCP_TOKEN=FAKE-MCP-TOKEN-REPLACE-ME-000000

# --- admin dashboard ---
# Generate a private operator password and a separate signing secret.
# Set both values before starting the dashboard. It refuses to start while either is blank.
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
# Optional Discord OAuth for the dashboard. Add the callback URL in the
# Discord application's OAuth2 settings, then set the secret and the Discord
# user IDs allowed to sign in. All four values are required together.
DISCORD_CLIENT_SECRET=
DASHBOARD_OAUTH_REDIRECT_URI=
DASHBOARD_OWNER_IDS=
# Dashboard listener and internal control API address.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000
# Host interface the published port binds to. Use 127.0.0.1 behind a local proxy.
DASHBOARD_BIND=0.0.0.0
# Set both only when a TLS reverse proxy is in front of the dashboard.
DASHBOARD_TRUST_PROXY=false
DASHBOARD_SECURE_COOKIES=false
CONTROL_API_URL=http://bot-control:3001

# --- optional: derived/auto-detected ---
# The init script derives DISCORD_CLIENT_ID from the token.
DISCORD_CLIENT_ID=
# Optional pin to one guild. Leave empty to serve every guild the bot joins.
# Set it to keep a voice-worker deployment scoped to a single server.
GUILD_ID=

# --- generated by scripts/podman-init.sh ---
POSTGRES_USER=siela
POSTGRES_DB=siela
POSTGRES_PASSWORD=FAKE-POSTGRES-PASSWORD-REPLACE-ME-00
DATABASE_URL=postgres://siela:FAKE-POSTGRES-PASSWORD-REPLACE-ME-00@postgres:5432/siela

# --- optional ownership / admin ---
# Comma-separated role IDs with admin access to bot config commands.
# ADMIN_ROLE_IDS=
# Discord user ID of the bot owner (owner-only commands).
# BOT_OWNER_ID=

# --- optional scheduled voice events ---
# Requires licensed audio files in apps/bot/assets/events/.
EVENT_SCHEDULE_ENABLED=false
EVENT_PRAYER=Dhuhr

# --- cache (compose provides a default; uncomment to override) ---
# VALKEY_URL=redis://valkey:6379

# --- local LLM (compose provides defaults; uncomment to override) ---
# The stack runs llama.cpp server (OpenAI-compatible) on the `llm` service.
# LLM_URL=http://llm:8000
# LLM_MODEL=DeathSurfing/tinyTanLLM-delulu-gemma
# Token for gated Hugging Face models (passed through to KittenTTS).
# HF_TOKEN=

# --- TTS (compose provides defaults; uncomment to override) ---
# KittenTTS service (:8000). TTS_STREAM=true streams /synthesize-stream.
# TTS_SERVICE_URL=http://tts:8000
# TTS_STREAM=true
# Backend: edge (Edge TTS fallback), kitten, kitten-mini.
# TTS_BACKEND=edge
# TTS_VOICE=Bruno

# --- optional watchtower (auto-deploy from GitHub) ---
# Watches WATCHTOWER_BRANCH, waits for CI, pulls, rebuilds, runs migrations,
# and rolls back when the bot fails its health gate.
# false = no watchtower container (default)
WATCHTOWER_ENABLED=false
# Follow a fork by pointing these at your repository.
# WATCHTOWER_REPO_URL=https://github.com/DeathSurfing/siela-bot.git
# WATCHTOWER_BRANCH=main
# Absolute path of this checkout on the host. Required when enabled; the
# overlay mounts it at the same path so host Podman can resolve builds.
# WATCHTOWER_REPO_DIR=/root/siela-bot
# Bearer token for POST /trigger. scripts/podman-init.sh generates one.
# WATCHTOWER_TOKEN=FAKE-WATCHTOWER-TOKEN-REPLACE-ME-0000
# GitHub token: required for private forks; recommended to avoid CI API limits.
# GH_TOKEN=
# CI gate: auto (wait, but deploy if no checks appear), required, off.
# WATCHTOWER_CI_GATE=auto
# Seconds to wait for the first check run, and the full CI deadline.
# WATCHTOWER_CI_GRACE_SEC=180
# WATCHTOWER_CI_TIMEOUT_SEC=900
# Seconds to wait for /readyz after a deploy before rolling back.
# WATCHTOWER_HEALTH_TIMEOUT_SEC=180
# Passed to `podman build --network=...`; use host if image builds need the host network.
# WATCHTOWER_BUILD_NETWORK=
# Optional Discord webhook for deploy and rollback notifications.
# WATCHTOWER_NOTIFY_WEBHOOK_URL=
# Log-only mode: compute and log the plan without pulling or deploying.
# WATCHTOWER_DRY_RUN=false

# --- control API / health (defaults; uncomment to override) ---
# Control API is Bearer-authenticated (MCP_TOKEN) on the control network.
# CONTROL_API_HOST=0.0.0.0
# CONTROL_API_PORT=3001
# Health/metrics listener; localhost-bound inside the container, not published.
# HEALTH_HOST=127.0.0.1
# HEALTH_PORT=3002

# --- voice fleet (N bots, one control entrypoint) ---
# Single bot by default. To run N simultaneous voice channels, create one
# Discord app per node, copy deploy/podman/.env.voice.example to
# .env.voice-1..N, then run scripts/make-voice-overlay.sh <N>.
# The router (:3100) fans music out by nodeId; everything else proxies to
# the commander. See docs/VOICE-FLEET.md.
# COMMANDER_URL=http://bot-control:3001
# NODES=commander=http://bot-control:3101,voice-1=http://bot-voice-1:3101
# Static fallback. Live fleet membership comes from Valkey heartbeats
# (keys siela:fleet:node:* with a 45s TTL) when VALKEY_URL is set:
# dead nodes expire, restarts re-register with no cleanup.
# VALKEY_URL=redis://valkey:6379
# ROUTER_URL=http://voice-router:3100
# The commander calls POST <ROUTER_URL>/v1/session/preempt before scheduled
# event audio so worker playback never overlaps azan/anthem/etc.
# NODE_ROLE=commander
# NODE_ID=commander
# Each node advertises its worker API for the Valkey session registry:
# NODE_ADVERTISE_URL=http://bot-control:3101
# (workers use http://bot-voice-<i>:3101)
# WORKER_INTERNAL_PORT=3101
# ROUTER_PORT=3100

# --- optional defaults ---

MUSIC_BACKEND=mpv
YTDLP_PATH=yt-dlp
MPV_PATH=mpv
FFMPEG_PATH=ffmpeg
DEFAULT_PREFIX=!
AUDIT_RETENTION_DAYS=90
LOG_LEVEL=info
TZ=UTC
