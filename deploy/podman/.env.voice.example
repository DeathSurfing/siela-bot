# Per-node env for one voice worker. Copy to .env.voice-<i> (i = 1..N).
#
#   cp deploy/podman/.env.voice.example deploy/podman/.env.voice-1
#
# Each worker needs its OWN Discord application token. Create one bot per
# node at https://discord.com/developers/applications, invite each to the
# guild, then run scripts/make-voice-overlay.sh <N>.
#
# Do NOT commit .env.voice-*.
DISCORD_TOKEN=FAKE-VOICE-WORKER-TOKEN-REPLACE-ME-000000
DISCORD_CLIENT_ID=
GUILD_ID=
MCP_TOKEN=FAKE-MCP-TOKEN-MUST-MATCH-MAIN-ENV-000000
DATABASE_URL=postgres://siela:FAKE-POSTGRES-PASSWORD@postgres:5432/siela
VALKEY_URL=redis://valkey:6379
NODE_ROLE=voice
LOG_LEVEL=info
TZ=UTC
