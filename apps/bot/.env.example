# Local development environment for apps/bot.
# Copy to apps/bot/.env and fill in the values.
# Never commit the real .env file.

DISCORD_TOKEN=replace-with-your-bot-token
GUILD_ID=

DATABASE_URL=postgres://siela:siela@127.0.0.1:5432/siela
MCP_TOKEN=dev-token-at-least-16
VALKEY_URL=redis://127.0.0.1:6379

CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=3001
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3002
LOG_LEVEL=debug
TZ=UTC

